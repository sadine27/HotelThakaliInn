{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hotel-thakali-inn",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": true
  },
  /* The bought domain. `custom_domain` provisions the certificate and the DNS
     record itself, so there is nothing to add in the dashboard. Both hostnames
     serve the same Worker rather than one redirecting to the other — a redirect
     would be a Cloudflare rule living outside this file, and `metadataBase`
     already emits the apex as the canonical URL, so search engines only ever see
     one address.

     The old *.workers.dev host does NOT survive this: wrangler disables it when
     `workers_dev` is absent from the config, and the 2026-08-29 deploy said so.
     That is the intent — one public address — but it means there is no longer a
     second URL to test against. Set "workers_dev": true here if you ever want a
     staging host back. */
  "routes": [
    { "pattern": "hotelthakaliinn.com", "custom_domain": true },
    { "pattern": "www.hotelthakaliinn.com", "custom_domain": true }
  ],
  "images": {
    "binding": "IMAGES"
  },
  /* Both ends pinned. `/api/contact` is public and unauthenticated, so a bug that
     ever let a guest choose the recipient would otherwise turn the hotel's domain
     into an open relay — with these, the only thing this Worker can do is mail the
     hotel from its own address. Changing the `email` settings row therefore needs
     a matching edit here; the send is caught and logged if it doesn't. */
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_destination_addresses": ["hotelthakaliinn1@gmail.com"],
      "allowed_sender_addresses": ["notify@hotelthakaliinn.com"]
    }
  ],
  /* Two limiters, because one cannot do both jobs. LOGIN_IP stops a person
     sitting there guessing; LOGIN_ALL stops a botnet parallelising the same
     guess across a thousand addresses, where every individual IP looks polite.
     `period` accepts only 10 or 60. Neither counter survives a deploy, which is
     fine — these buy time against a brute force, and the PBKDF2 cost is what
     actually makes the password expensive to attack. */
  "ratelimits": [
    { "name": "LOGIN_IP", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "LOGIN_ALL", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "thakali-inn-contact",
      "database_id": "62a811d5-4f4b-4268-9b3d-6ea35a08d7e1"
    }
  ],
  /* Not a public bucket. Serving through the Worker means one URL shape, no
     second hostname to configure, and no way to reach an object except through
     code we wrote. `/img/*` sends `immutable`, so the CDN answers nearly every
     request and R2 sees roughly one read per image per edge — which is what
     keeps this inside the free tier rather than a promise that it will. */
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "thakali-inn-media" }]
}
